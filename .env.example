# Copy to .env and adjust for your environment.

# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (docker-compose uses postgres) ---
DB_ENGINE=postgres
DB_NAME=crm
DB_USER=crm
DB_PASSWORD=crm
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Set to False once Redis + a worker are actually running (docker-compose does this).
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (console backend logs to stdout; swap for SMTP in prod) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=crm@example.com

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
